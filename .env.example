# Configuracion del bot. NO compartas este fichero.
# El instalador rellena el token; esto es solo la plantilla.

TELEGRAM_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MODO=v2 -> usa el motor v2 (opencode-cli.exe) mediante el shim. Puerto 4095.
# MODO=v1 -> habla directo con un motor v1 (opencode serve), propio o en WSL.
MODO=v2

# A donde apunta el bot. Lo escribe el instalador segun el modo.
OPENCODE_URL=http://127.0.0.1:4095
OPENCODE_USER=opencode
OPENCODE_PASS=opencode123

# --- Solo si usas el motor de WSL (MODO=v1) ---------------------------------
# WSL_DISTRO=Ubuntu
# WSL_CMD=opencode serve --port 4096 --hostname 0.0.0.0
# Ojo: debe escuchar en 0.0.0.0 para que Windows lo alcance.

# --- Solo modo v2 ----------------------------------------------------------
# Opcional: ruta explicita a opencode-cli.exe si no se detecta solo.
# OC_ENGINE=C:\Users\tu_usuario\AppData\Roaming\ai.opencode.desktop\cli\2.2.2-x64\opencode-cli.exe

# Opcional: carpeta de trabajo de las sesiones nuevas.
# OC_DIR=C:\Users\tu_usuario\proyectos
